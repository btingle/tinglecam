# A C++ OCCT SDK is independent of the Python cadquery-ocp installation.
set(TINGLECAM_OCCT_ROOT "" CACHE PATH "Open CASCADE SDK prefix")
find_path(TINGLE_OCCT_INCLUDE Standard.hxx
  HINTS "${TINGLECAM_OCCT_ROOT}/include/opencascade" "${TINGLECAM_OCCT_ROOT}/usr/include/opencascade"
  PATH_SUFFIXES opencascade)
set(_occt_libdirs "${TINGLECAM_OCCT_ROOT}/lib" "${TINGLECAM_OCCT_ROOT}/lib/x86_64-linux-gnu"
                  "${TINGLECAM_OCCT_ROOT}/usr/lib/x86_64-linux-gnu")
set(TINGLE_OCCT_LIBRARIES)
foreach(_component TKernel TKMath TKG2d TKG3d TKGeomBase TKBRep TKGeomAlgo TKTopAlgo TKPrim TKMesh TKXSBase)
  find_library(TINGLE_OCCT_${_component} NAMES ${_component} HINTS ${_occt_libdirs})
  if(NOT TINGLE_OCCT_${_component})
    set(TINGLE_OCCT_MISSING TRUE)
  else()
    list(APPEND TINGLE_OCCT_LIBRARIES ${TINGLE_OCCT_${_component}})
  endif()
endforeach()
find_library(TINGLE_OCCT_STEP NAMES TKDESTEP TKSTEP HINTS ${_occt_libdirs})
if(TINGLE_OCCT_STEP MATCHES "TKSTEP")
  foreach(_component TKSTEPBase TKSTEPAttr TKShHealing)
    find_library(TINGLE_OCCT_${_component} NAMES ${_component} HINTS ${_occt_libdirs})
    if(TINGLE_OCCT_${_component})
      list(APPEND TINGLE_OCCT_LIBRARIES ${TINGLE_OCCT_${_component}})
    endif()
  endforeach()
endif()
if(TINGLE_OCCT_INCLUDE AND TINGLE_OCCT_STEP AND NOT TINGLE_OCCT_MISSING)
  add_library(tinglecam_occt INTERFACE)
  target_include_directories(tinglecam_occt SYSTEM INTERFACE ${TINGLE_OCCT_INCLUDE})
  if(UNIX AND NOT APPLE AND TINGLECAM_OCCT_ROOT)
    # A relocatable extracted SDK also needs its indirect OCCT dependencies.
    target_link_options(tinglecam_occt INTERFACE "LINKER:--disable-new-dtags")
  endif()
  target_link_libraries(tinglecam_occt INTERFACE ${TINGLE_OCCT_STEP} ${TINGLE_OCCT_LIBRARIES})
  set(TINGLE_OCCT_FOUND TRUE)
endif()
